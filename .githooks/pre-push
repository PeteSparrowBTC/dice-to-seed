#!/bin/sh
# Blocks pushes that would move main directly.
#
# This is the client-side half of the guard. This repository is public, so the
# authoritative rule is a server-side branch protection on main ("Require a
# pull request before merging", with "Do not allow bypassing" enabled). See
# CLAUDE.md for the exact setup and how to verify it. This hook exists so a
# mistake fails immediately and locally, with a message naming the way out,
# instead of after a network round-trip.
#
# Enable it per clone (git does not share hooks itself):
#     git config core.hooksPath .githooks
#
# Bypass deliberately, when you genuinely mean it:
#     git push --no-verify ...
#
# git feeds pre-push one line per ref being pushed on stdin:
#     <local ref> <local sha> <remote ref> <remote sha>

BLOCKED=0

while read -r _local_ref _local_sha remote_ref _remote_sha; do
    case "$remote_ref" in
        refs/heads/main)
            echo "✗ Refusing to push directly to main." >&2
            echo "  main should only move through a merged pull request:" >&2
            echo "    git switch -c my-branch && git push -u origin my-branch && gh pr create" >&2
            BLOCKED=1
            ;;
    esac
done

if [ "$BLOCKED" -ne 0 ]; then
    echo "" >&2
    echo "  Override with --no-verify if you are certain (branch protection will still refuse)." >&2
    exit 1
fi

exit 0
