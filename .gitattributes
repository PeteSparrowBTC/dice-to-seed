# Shell scripts and python must keep LF line endings in the working tree, on every platform.
#
# Why this matters here: .githooks/pre-push is the client-side guard against pushing to main.
# If git checks it out with CRLF (the default on Windows when core.autocrlf is true), the
# shebang line becomes "#!/bin/sh\r" and a POSIX shell reports "bad interpreter: No such file
# or directory". Git then treats the hook as failed to run, and on some paths simply skips it:
# a guard that looks installed but never blocks anything. Pinning eol=lf keeps the hook
# executable on Linux and macOS clones.
.githooks/** text eol=lf
*.sh text eol=lf
*.py text eol=lf

# The BIP-39 wordlist is hashed and compared against a known SHA-256 at runtime. A CRLF
# checkout would change every line and therefore the hash, so the integrity check would
# fail on a Windows clone for a reason that has nothing to do with the file's contents.
*.txt text eol=lf

# The published BIP-39 test vectors are kept byte for byte as upstream publishes them, and
# their SHA-256 is asserted, so that the suite can prove it is running the real vectors and
# not a copy someone adjusted until the tests went green. Same CRLF reasoning as above.
DiceToSeed.Tests/Vectors/** text eol=lf
packaging/appimage/AppRun text eol=lf
packaging/appimage/*.desktop text eol=lf
