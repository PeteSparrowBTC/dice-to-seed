# .NET build output
bin/
obj/
[Dd]ebug/
[Rr]elease/
publish/
*.user
project.lock.json
artifacts/

# IDE
.idea/
.vs/
.vscode/

# Python (the wordlist verification helper, if one is added)
__pycache__/
*.pyc

# Never commit anything that could hold a real roll log or a real seed. These names are
# reserved so an accidental "save my working notes here" cannot reach a public repository.
*.rolls
*.seed
scratch/

# Browser-driven UI checks write screenshots and page snapshots here. They are throwaway
# evidence for a single session, and a screenshot of this app can contain a roll log.
.playwright-mcp/
# Only PNGs at the repository root, which is where browser-driven checks drop screenshots.
# An unanchored *.png swallowed the AppImage icon and then the Tauri icon: application assets
# live in subdirectories and must not be caught by a debris rule.
/*.png
src-tauri/target/

# Downloaded build artifacts. CI is their source of truth; a repository whose value is that
# you can read it has no business carrying 36 MB binaries.
dist/
